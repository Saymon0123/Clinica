VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domínio público do CRM, usado nos links de convite e de redefinição de senha.
# Precisa ser o domínio de produção — uma URL de deployment da Vercel
# (clubcut-<hash>-<conta>.vercel.app) fica atrás da proteção da plataforma e
# quem receber o link cai na tela de login da Vercel.
#
# O Vite embute este valor em BUILD TIME: mudar a variável na Vercel sem
# redeploy não faz efeito nenhum.
VITE_APP_URL=https://clubcut.vercel.app
