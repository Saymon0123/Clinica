VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domínio público do CRM, usado nos links de convite e de redefinição de senha.
# Precisa ser o domínio de produção — uma URL de deployment da Vercel
# (clubcut-<hash>-<conta>.vercel.app) fica atrás da proteção da plataforma e
# quem receber o link cai na tela de login da Vercel.
#
# O Vite embute este valor em BUILD TIME: mudar a variável na Vercel sem
# redeploy não faz efeito nenhum.
VITE_APP_URL=https://clubcut.vercel.app

# DSN do projeto no Sentry (sentry.io > Settings > Projects > Client Keys).
# É um identificador público, não um segredo. Sem ela o monitoramento fica
# desligado e o app funciona normalmente — é o esperado em dev.
#
# O Vite embute este valor em BUILD TIME: mudar a variável na Vercel sem
# redeploy não faz efeito nenhum.
VITE_SENTRY_DSN=

# Upload de source maps para o Sentry durante o build (stack trace legível em
# produção). Só fazem sentido no ambiente de build da Vercel; sem as três o
# build sai idêntico ao de antes. O token vem de Settings > Auth Tokens e ESTE
# é segredo de verdade — nunca com prefixo VITE_, senão vai parar no bundle.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# URL do webhook n8n do agente de tira-dúvidas do popup de WhatsApp da landing
# (workflow "Landing - Agente de Tira-Dúvidas (Popup)"). Sem essa variável o
# popup mostra "em breve" em vez de fingir que responde.
#
# O Vite embute este valor em BUILD TIME: mudar a variável na Vercel sem
# redeploy não faz efeito nenhum.
VITE_AGENTE_IA_URL=
